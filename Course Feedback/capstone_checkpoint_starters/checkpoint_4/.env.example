# Copy this file to .env (in the same folder) and fill in the values.
# .env holds a secret: it is listed in .gitignore and must never be shared or committed.

# The OpenRouter API key provided for the course.
OPENROUTER_API_KEY=sk-or-your-key-here

# The capstone scenario chosen in Checkpoint 1: wikipedia or papers.
# (emails also works: it is the corpus the labs use.)
RAG_SCENARIO=wikipedia

# The folder that holds the scenario's documents:
#   wikipedia -> the folder of .html articles
#   papers    -> the folder of .pdf papers
#   emails    -> the folder of .txt emails
RAG_CORPUS_DIR=/full/path/to/CapstoneDatasets/Wikipedia

# Where logs, reports, indexes, and question sets are kept.
# Keep it OUTSIDE the project folder, so it survives moving to a newer checkpoint folder.
# If left empty, a folder named rag_course_work in the home directory is used.
RAG_WORK_DIR=

# Optional: the chat model (default openai/gpt-5.4-mini) and the embedding model.
# RAG_MODEL=openai/gpt-5.4-mini
# RAG_EMBEDDING_MODEL=openai/text-embedding-3-small
